{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/openttd-blueprint/schema/profile.schema.json",
  "title": "OpenTTD Blueprint profile",
  "type": "object",
  "required": [
    "schema_version", "name", "display_name", "description",
    "blueprint_version", "openttd_min_version", "gameplay"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "display_name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "blueprint_version": { "type": "string" },
    "openttd_min_version": { "type": "string" },
    "gameplay": {
      "type": "object",
      "required": ["starting_year", "map_size", "cargodist", "vehicle", "economy"],
      "additionalProperties": false,
      "properties": {
        "starting_year": { "type": "integer" },
        "map_size": {
          "type": "object",
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "integer" },
            "y": { "type": "integer" }
          }
        },
        "cargodist": {
          "type": "object",
          "properties": {
            "distribution_pax": { "type": "string" },
            "distribution_mail": { "type": "string" },
            "distribution_armoured": { "type": "string" },
            "distribution_default": { "type": "string" }
          }
        },
        "vehicle": { "type": "object" },
        "economy": { "type": "object" },
        "town_growth": { "type": "object" },
        "industry": { "type": "object" }
      }
    }
  }
}
